# Copy to env/.env. Never commit env/ or actual secret values.
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
HOST=127.0.0.1
PORT=3000
# Set to 1 only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
